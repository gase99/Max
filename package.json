{
  "name": "cabinet-analysis-pro",
  "private": true,
  "version": "0.1.0",
  "description": "Cabinet Analysis Pro — industrial cabinet & MDF analysis, cutting list and sheet optimisation",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "test": "npm run test -w @cabinet/engine",
    "test:web": "vitest run --root apps/web",
    "test:all": "npm run test && npm run test:web",
    "build:engine": "npm run build -w @cabinet/engine",
    "dev": "npm run dev -w @cabinet/web",
    "build": "npm run build -w @cabinet/web",
    "preview": "npm run preview -w @cabinet/web",
    "desktop": "cd apps/desktop && npm start",
    "dist:win": "cd apps/desktop && npm run dist:win"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0"
  }
}
